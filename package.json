{
  "name": "esaus-trails",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "api": "tsx --env-file-if-exists=.env server/index.mjs",
    "esau:spots": "tsx --env-file-if-exists=.env server/esau/sample-spots.ts",
    "typecheck:server": "tsc -p server/esau/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
