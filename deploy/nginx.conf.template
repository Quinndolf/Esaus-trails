# Esau's Trails. Only answers requests for __DOMAINS__, so other sites on this server are untouched.
# Written by deploy/setup.sh; certbot adds the HTTPS lines below this on its own.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAINS__;

    root /opt/esaus-trails/site;
    index index.html;

    # Photos ride along to Esau as base64.
    client_max_body_size 15m;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    location /api/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Hashed file names never change, so phones can keep them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # These must be checked on every open or updates never reach installed phones.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
