# Server-side only (server/index.mjs reads this). Never ship it to the browser.
ANTHROPIC_API_KEY=
# Optional
ESAU_MODEL=claude-opus-5-5
ESAU_EFFORT=low
ESAU_RATE_PER_MIN=20
# Comma-separated origins allowed to call /api/esau, e.g. https://esaustrails.example.com
ESAU_ALLOWED_ORIGINS=
PORT=8787
# Set to 127.0.0.1 on the server so the API is only reachable through nginx
HOST=
# NWS wants contact info, e.g. "esaus-trails, you@example.com"
NWS_USER_AGENT=
