{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ground.ts": { "maxDuration": 30 },
    "api/esau.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/nws/:path*", "destination": "/api/nws?path=/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
